# VSense-HIL Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Simulated Hardware Disclaimer:
# All sensor hardware in VSense-HIL is simulated for HIL telemetry testing.

# C++ Telemetry Daemon Configuration
VSENSE_DEVICE_PATH=/dev/vsensor0
VSENSE_LOG_LEVEL=info
VSENSE_CLOUD_URL=http://localhost:8000/api/v1/telemetry
VSENSE_API_KEY=vsense_secret_api_key_12345
VSENSE_BATCH_SIZE=10
VSENSE_FLUSH_INTERVAL_MS=1000

# Cloud Backend Configuration
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./vsense.db
API_KEY=vsense_secret_api_key_12345
CORS_ORIGINS=*

# Dashboard Configuration
VITE_API_URL=http://localhost:8000
